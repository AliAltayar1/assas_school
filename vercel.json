{
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://api.asasnationalschools.tech/api/"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://api.asasnationalschools.tech/api/$1"
    },
    {
      "source": "/csrf/(.*)",
      "destination": "https://api.asasnationalschools.tech/csrf/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "https://api.asasnationalschools.tech/media/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
